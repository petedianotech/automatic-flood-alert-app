{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with name, village, and authentication details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "User ID", "maxLength": 128 },
        "name": { "type": "string", "description": "User full name", "maxLength": 100 },
        "village": { "type": "string", "description": "Village or community name", "maxLength": 100 },
        "email": { "type": "string", "description": "Optional email address", "maxLength": 200 },
        "photoURL": { "type": "string", "description": "Optional profile photo URL", "maxLength": 500 },
        "authProvider": { "type": "string", "description": "Authentication method", "enum": ["name_village", "google"] },
        "hasPassword": { "type": "boolean", "description": "Whether an optional password was set" },
        "createdAt": { "type": "string", "description": "ISO timestamp of account creation" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      },
      "required": ["uid", "name", "village", "authProvider"]
    },
    "FloodAlert": {
      "title": "FloodAlert",
      "description": "Critical flood and water vibration sensor telemetry alerts.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "number", "description": "Epoch timestamp in milliseconds" },
        "formattedTime": { "type": "string", "description": "Human readable time", "maxLength": 50 },
        "peakDelta": { "type": "number", "description": "Peak vibration magnitude delta" },
        "durationSeconds": { "type": "number", "description": "Duration of continuous vibration" },
        "nodeId": { "type": "string", "description": "Sensor node identifier", "maxLength": 64 },
        "nodeName": { "type": "string", "description": "Human readable sensor location name", "maxLength": 100 },
        "village": { "type": "string", "description": "Village where sensor is stationed", "maxLength": 100 },
        "status": { "type": "string", "description": "Alert status", "enum": ["active", "dismissed"] },
        "dismissedBy": { "type": "string", "description": "Name or role of person who dismissed alert", "maxLength": 100 },
        "dismissedAt": { "type": "number", "description": "Epoch timestamp of dismissal" },
        "source": { "type": "string", "description": "Detection source", "enum": ["hardware_sensor", "manual_test", "simulated"] },
        "notes": { "type": "string", "description": "Optional incident notes", "maxLength": 500 },
        "userId": { "type": "string", "description": "Authoring user UID", "maxLength": 128 },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["timestamp", "peakDelta", "nodeId", "nodeName", "status", "source"]
    },
    "ResidentSafetyReport": {
      "title": "ResidentSafetyReport",
      "description": "Resident roll-call and flood safety status reports.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Resident UID", "maxLength": 128 },
        "userName": { "type": "string", "description": "Resident name", "maxLength": 100 },
        "village": { "type": "string", "description": "Village name", "maxLength": 100 },
        "status": { "type": "string", "description": "Safety status", "enum": ["safe", "in_flooding", "needs_help", "evacuated"] },
        "statusLabel": { "type": "string", "description": "Human readable description", "maxLength": 100 },
        "peopleCount": { "type": "number", "description": "Family members headcount" },
        "phone": { "type": "string", "description": "Emergency contact phone", "maxLength": 50 },
        "message": { "type": "string", "description": "Condition note or rescue details", "maxLength": 500 },
        "timestamp": { "type": "number", "description": "Epoch timestamp in milliseconds" },
        "formattedTime": { "type": "string", "description": "Formatted time string", "maxLength": 50 },
        "latitude": { "type": "number", "description": "GPS latitude" },
        "longitude": { "type": "number", "description": "GPS longitude" },
        "mapsUrl": { "type": "string", "description": "Google Maps link", "maxLength": 500 },
        "voiceAudioBase64": { "type": "string", "description": "Base64 encoded audio voice clip for hands-free rescue reporting", "maxLength": 500000 },
        "voiceDurationSec": { "type": "number", "description": "Audio recording duration in seconds" },
        "hasVoiceNote": { "type": "boolean", "description": "Whether an emergency voice note is attached" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of update" }
      },
      "required": ["userId", "userName", "village", "status", "timestamp"]
    },
    "FcmToken": {
      "title": "FcmToken",
      "description": "FCM device registration tokens for background alerts delivery.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "FCM push registration token" },
        "userId": { "type": "string", "description": "Owner UID", "maxLength": 128 },
        "userName": { "type": "string", "description": "User name", "maxLength": 100 },
        "village": { "type": "string", "description": "Village name", "maxLength": 100 },
        "userAgent": { "type": "string", "description": "Client browser / device info", "maxLength": 300 },
        "updatedAt": { "type": "string", "description": "ISO timestamp" },
        "timestamp": { "type": "number", "description": "Epoch timestamp in milliseconds" }
      },
      "required": ["token", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records containing name and village affiliation."
    },
    "/flood_alerts/{alertId}": {
      "schema": "FloodAlert",
      "description": "Community and sensor flood event telemetry alerts."
    },
    "/safety_reports/{reportId}": {
      "schema": "ResidentSafetyReport",
      "description": "Community safety check-ins and emergency rescue requests."
    },
    "/fcm_tokens/{tokenId}": {
      "schema": "FcmToken",
      "description": "Device push tokens for background and closed-tab notifications."
    }
  }
}
