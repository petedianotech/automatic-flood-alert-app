rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.uid is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.village is string && data.village.size() > 0 && data.village.size() <= 100 &&
        data.authProvider in ['name_village', 'google'];
    }

    function isValidFloodAlert(data) {
      return data.timestamp is number &&
        data.peakDelta is number &&
        data.nodeId is string && data.nodeId.size() <= 64 &&
        data.nodeName is string && data.nodeName.size() <= 100 &&
        data.status in ['active', 'resolved', 'dismissed'] &&
        data.source in ['hardware_sensor', 'acoustic_sound_sensor', 'manual_test', 'simulated'];
    }

    function isValidSafetyReport(data) {
      return data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() > 0 && data.userName.size() <= 100 &&
        data.village is string && data.village.size() > 0 && data.village.size() <= 100 &&
        data.status in ['safe', 'in_flooding', 'needs_help', 'evacuated'] &&
        data.timestamp is number &&
        (!('voiceAudioBase64' in data) || (data.voiceAudioBase64 is string && data.voiceAudioBase64.size() <= 500000));
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Flood Alerts
    match /flood_alerts/{alertId} {
      allow read: if true;
      allow create: if isValidFloodAlert(request.resource.data);
      allow update: if
        (request.resource.data.status == 'dismissed' || request.resource.data.status == 'resolved') &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'dismissedBy', 'dismissedAt']);
      allow delete: if isSignedIn();
    }

    // Resident Safety Reports & Roll-call
    match /safety_reports/{reportId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidSafetyReport(request.resource.data) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidSafetyReport(request.resource.data) && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow delete: if isSignedIn();
    }

    // FCM Device Push Notification Tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if isSignedIn();
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }
  }
}
